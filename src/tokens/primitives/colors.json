      "200": { "$value": { "colorSpace": "srgb", "components": [0.737255, 0.745098, 0.752941], "hex": "#BCBEC0" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.552941, 0.564706, 0.580392], "hex": "#8D9094" } },
