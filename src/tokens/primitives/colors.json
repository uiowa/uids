    "blue-wash": { "$value": { "colorSpace": "srgb", "components": [0.917647, 0.945098, 0.984314], "hex": "#EAF1FB" } },
    "green-wash": { "$value": { "colorSpace": "srgb", "components": [0.901961, 0.956863, 0.933333], "hex": "#E6F4EE" } },
