    "alpha": {
      "$description": "Translucent colors. The numeric suffix gives opacity in thousandths (425 = 42.5%).",
      "black-125": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.125, "hex": "#000000" } },
      "black-200": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.2, "hex": "#000000" } },
      "black-425": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.425, "hex": "#000000" } },
      "near-black-150": { "$value": { "colorSpace": "srgb", "components": [0.0392, 0.0392, 0.0392], "alpha": 0.15, "hex": "#0A0A0A" } },
      "white-325": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.325, "hex": "#FFFFFF" } },
      "white-425": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.425, "hex": "#FFFFFF" } }
