{
  "color": {
    "gold": { "$value": "#FFCD00", "$description": "Hawkeye Gold, the primary brand color." },
    "black": { "$value": "#000000", "$description": "Brand black." },
    "white": { "$value": "#FFFFFF" },
    "blue": { "$value": "#00558C", "$description": "Brand blue." },
    "neutral": {
      "$description": "Tone naming: the number is the value's L* lightness, so a higher number is lighter.",
      "96": { "$value": "#F3F3F3" },
      "81": { "$value": "#CACACA" },
      "64": { "$value": "#9A9A9A" },
      "48": { "$value": "#737373" },
      "43": { "$value": "#63666A" }
    },
    "status": {
      "$description": "Status colors. Each has a -light counterpart for use as a background tint.",
      "success": { "$value": "#00664F" },
      "success-light": { "$value": "#EBFFFA", "$description": "Success background tint." },
      "info": { "$value": "#00558C" },
      "info-light": { "$value": "#EDF8FF", "$description": "Info background tint." },
      "warning": { "$value": "#FFCD00" },
      "warning-light": { "$value": "#FFF8D9", "$description": "Warning background tint." },
      "danger": { "$value": "#BD472A" },
      "danger-light": { "$value": "#F7E2DD", "$description": "Error background tint." }
    },
    "alpha": {
      "$description": "Translucent colors. The number is the alpha per-mille — black-125 is rgba(0, 0, 0, 0.125).",
      "black-125": { "$value": "rgba(0, 0, 0, 0.125)" },
      "white-325": { "$value": "rgba(255, 255, 255, 0.325)" }
    }
  }
}
