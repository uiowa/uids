    "cyan": { "$value": { "colorSpace": "srgb", "components": [0.141176, 0.611765, 0.690196], "hex": "#249CB0" } },
    "olive": { "$value": { "colorSpace": "srgb", "components": [0.490196, 0.596078, 0.278431], "hex": "#7D9847" } },
