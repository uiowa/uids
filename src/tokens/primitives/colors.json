{
  "color": {
    "$type": "color",
    "gold": { "$value": { "colorSpace": "srgb", "components": [1, 0.803922, 0], "hex": "#FFCD00" }, "$description": "Hawkeye Gold." },

    "neutral": {
      "$description": "Text, surfaces, borders, and dividers. Step names are ordinals; a higher number is darker.",
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.952941, 0.952941, 0.952941], "hex": "#F3F3F3" } },
      "150": { "$value": { "colorSpace": "srgb", "components": [0.917647, 0.921569, 0.92549], "hex": "#EAEBEC" } },
      "175": { "$value": { "colorSpace": "srgb", "components": [0.847059, 0.854902, 0.862745], "hex": "#D8DADC" } },
      "200": { "$value": { "colorSpace": "srgb", "components": [0.737255, 0.745098, 0.752941], "hex": "#BCBEC0" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.552941, 0.564706, 0.580392], "hex": "#8D9094" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.466667, 0.478431, 0.498039], "hex": "#777A7F" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.388235, 0.4, 0.415686], "hex": "#63666A" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.211765, 0.227451], "hex": "#33363A" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.137255, 0.145098, 0.152941], "hex": "#232527" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } }
    },

    "blue": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.458824, 0.819608], "hex": "#3375D1" } },
    "blue-dark": { "$value": { "colorSpace": "srgb", "components": [0, 0.333333, 0.54902], "hex": "#00558C" } },
    "teal": { "$value": { "colorSpace": "srgb", "components": [0.023529, 0.588235, 0.494118], "hex": "#06967E" } },
    "orange": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.427451, 0.090196], "hex": "#CC6D17" } },
    "magenta": { "$value": { "colorSpace": "srgb", "components": [0.666667, 0.286275, 0.505882], "hex": "#AA4981" } },
    "ochre": { "$value": { "colorSpace": "srgb", "components": [0.752941, 0.54902, 0], "hex": "#C08C00" } },

    "green": { "$value": { "colorSpace": "srgb", "components": [0.054902, 0.419608, 0.301961], "hex": "#0E6B4D" } },
    "ochre-dark": { "$value": { "colorSpace": "srgb", "components": [0.545098, 0.419608, 0.07451], "hex": "#8B6B13" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [0.752941, 0.223529, 0.168627], "hex": "#C0392B" } },

    "blue-wash": { "$value": { "colorSpace": "srgb", "components": [0.917647, 0.945098, 0.984314], "hex": "#EAF1FB" } },
    "green-wash": { "$value": { "colorSpace": "srgb", "components": [0.901961, 0.956863, 0.933333], "hex": "#E6F4EE" } },
    "ochre-wash": { "$value": { "colorSpace": "srgb", "components": [0.984314, 0.952941, 0.862745], "hex": "#FBF3DC" } },
    "red-wash": { "$value": { "colorSpace": "srgb", "components": [0.984314, 0.917647, 0.917647], "hex": "#FBEAEA" } },

    "alpha": {
      "$description": "Translucent colors. The number is the alpha per-mille.",
      "black-125": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.125, "hex": "#000000" } },
      "white-325": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.325, "hex": "#FFFFFF" } }
    }
