{
  "typography": {
    "font-family": {
      "sans": { "$value": "'Roboto', sans-serif", "$description": "4.x: $font-family-sans-serif" },
      "serif": { "$value": "'Zilla Slab', 'Zilla-fallback', serif", "$description": "4.x: $font-family-serif" },
      "serif-alt": { "$value": "'Lora', serif", "$description": "4.x: $font-family-serif-alt" },
      "caps": { "$value": "'Antonio', 'Antonio-fallback', sans-serif", "$description": "4.x: $font-family-caps / -caps-light / -caps-bold (all identical). Uppercase display family." }
    },
    "font-weight": {
      "light": { "$value": "300", "$description": "4.x: $font-weight-light" },
      "normal": { "$value": "400", "$description": "4.x: $font-weight-normal" },
      "medium": { "$value": "500", "$description": "4.x: $font-weight-medium / $headings-font-weight" },
      "medium-bold": { "$value": "600", "$description": "4.x: $font-weight-medium-bold" },
      "bold": { "$value": "700", "$description": "4.x: $font-weight-bold" },
      "heavy": { "$value": "900", "$description": "4.x: $font-weight-heavy" }
    },
    "font-size": {
      "25": { "$value": "0.75rem", "$description": "12px. Badge. A NEW step BELOW 50, minted 2026-08-20 when badge/font-size stopped being a percentage of its inherited context (the design system owner's de-flex ruling). NOTE the scale is abstract and gapped, NOT rem x 100 — that convention belongs to space.*. font-size.75 is already 0.9rem, so 0.75rem could not take the name its rem value suggests; it needed a step below the previous floor. 0.75rem is exactly what 75% of a 1rem context always rendered, so this value is the old body-context rendering made absolute, not a new size." },
      "50": { "$value": "0.8rem", "$description": "12.8px. 4.x: $small-font-size, .is-small" },
      "75": { "$value": "0.9rem", "$description": "14.4px. figcaption (90% of base). Note: $label-font-size (0.9rem) was removed from _variables.scss in 1fbefb6f94; live labels use --form-label-font-size: 1rem (form.scss)." },
      "100": { "$value": "1rem", "$description": "16px. 4.x: $base-font-size, form labels. 5.x anchor: --uiowa-font-size-100" },
      "105": { "$value": "1.05rem", "$description": "16.8px. 4.x: .bttn--small font-size" },
      "125": { "$value": "1.1rem", "$description": "17.6px. Brand footer menu links. Also Forms .form--large --form-label-font-size (form.scss:394) — reused rather than minting a duplicate font-size.110 primitive." },
      "150": { "$value": "1.2rem", "$description": "19.2px. 4.x: $content-font-size (body, lists, .is-medium), $h6-font-size" },
      "200": { "$value": "1.25rem", "$description": "20px. 4.x: .bttn font-size. 5.x anchor: --uiowa-font-size-200" },
      "250": { "$value": "1.3rem", "$description": "20.8px. h5 clamp small end; serif h5 small end" },
      "300": { "$value": "1.4rem", "$description": "22.4px. h5 clamp large end ($h5-font-size)" },
      "325": { "$value": "1.425rem", "$description": "22.8px. serif h6 clamp large end" },
      "350": { "$value": "1.45rem", "$description": "23.2px. h4 clamp small end; serif h4 small end" },
      "375": { "$value": "1.5rem", "$description": "24px. Blockquote body; gap step between font-size.350 and font-size.400." },
      "400": { "$value": "1.6rem", "$description": "25.6px. h4 clamp large end ($h4-font-size); .is-large; intro clamps small end" },
      "425": { "$value": "1.625rem", "$description": "26px. serif h5 clamp large end" },
      "450": { "$value": "1.65rem", "$description": "26.4px. h3 clamp small end; serif h3 small end" },
      "475": { "$value": "1.7rem", "$description": "27.2px. Brand footer site-name" },
      "500": { "$value": "1.75rem", "$description": "28px. serif h2 clamp small end" },
      "515": { "$value": "1.8rem", "$description": "28.8px. Brand bar site-name mobile" },
      "525": { "$value": "1.825rem", "$description": "29.2px. serif h4 clamp large end" },
      "550": { "$value": "1.9125rem", "$description": "30.6px. h3 clamp large end ($h3-font-size)" },
      "600": { "$value": "1.95rem", "$description": "31.2px. h2 clamp small end" },
      "625": { "$value": "2rem", "$description": "32px. Brand bar site-name md" },
      "650": { "$value": "2.1rem", "$description": "33.6px. light-intro clamp large end" },
      "675": { "$value": "2.1375rem", "$description": "34.2px. serif h3 clamp large end" },
      "700": { "$value": "2.2rem", "$description": "35.2px. bold-intro clamp large end" },
      "750": { "$value": "2.3rem", "$description": "36.8px. h2 clamp large end ($h2-font-size); h1 clamp small end" },
      "800": { "$value": "2.525rem", "$description": "40.4px. serif h2 clamp large end" },
      "850": { "$value": "3.1rem", "$description": "49.6px. Stat horizontal title." },
      "900": { "$value": "3.35rem", "$description": "53.6px. h1 clamp large end ($h1-font-size)" },
      "925": { "$value": "3.5rem", "$description": "56px. Stat prefix/suffix." },
      "950": { "$value": "4rem", "$description": "64px. Stat title mobile." },
      "1000": { "$value": "5rem", "$description": "80px. Stat title at the 768px sm breakpoint." }
    },
    "line-height": {
      "100": { "$value": "1", "$description": "Stat title compact line-height." },
      "112": { "$value": "1.125", "$description": "h1 / heading base rule" },
      "115": { "$value": "1.15", "$description": "Table base line-height, inherited by captions (tables.scss:21)." },
      "125": { "$value": "1.25", "$description": "h2-h6" },
      "130": { "$value": "1.3", "$description": "bold intro; small element" },
      "140": { "$value": "1.4", "$description": "light intro; .bttn" },
      "150": { "$value": "1.5", "$description": "figcaption" },
      "160": { "$value": "1.6", "$description": "list items" },
      "167": { "$value": "1.67", "$description": "Badge base line-height (badge.scss:7). Single-consumer primitive retained per the Button-era migration precedent." },
      "170": { "$value": "1.7", "$description": "paragraph body" }
    },
    "letter-spacing": {
      "0": { "$value": "0", "$description": "Headings explicitly set letter-spacing: 0" }
    },
    "text-transform": {
      "none": { "$value": "none" },
      "uppercase": { "$value": "uppercase", "$description": ".bttn / headline-uppercase (Antonio)" }
    }
  }
}
