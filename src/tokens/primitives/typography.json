{
  "typography": {
    "font-family": {
      "roboto": { "$value": "'Roboto', sans-serif", "$description": "Default sans family — body, UI, and headings." },
      "zilla-slab": { "$value": "'Zilla Slab', 'Zilla-fallback', serif", "$description": "Headline serif." },
      "lora": { "$value": "'Lora', serif", "$description": "Long-form editorial serif." },
      "antonio": { "$value": "'Antonio', 'Antonio-fallback', sans-serif", "$description": "Uppercase display family." }
    },
    "font-weight": {
      "light": { "$value": "300" },
      "normal": { "$value": "400" },
      "medium": { "$value": "500" },
      "medium-bold": { "$value": "600" },
      "bold": { "$value": "700" },
      "heavy": { "$value": "900" }
    },
    "font-size": {
      "$description": "Step names are rem x 100, rounded, with exact halves rounded down. The scale is gapped so steps can be inserted between existing ones.",
      "80": { "$value": "0.8rem" },
      "90": { "$value": "0.9rem" },
      "100": { "$value": "1rem" },
      "120": { "$value": "1.2rem" },
      "130": { "$value": "1.3rem" },
      "140": { "$value": "1.4rem" },
      "145": { "$value": "1.45rem" },
      "160": { "$value": "1.6rem" },
      "165": { "$value": "1.65rem" },
      "191": { "$value": "1.9125rem" },
      "195": { "$value": "1.95rem" },
      "210": { "$value": "2.1rem" },
      "220": { "$value": "2.2rem" },
      "230": { "$value": "2.3rem" },
      "335": { "$value": "3.35rem" }
    },
    "line-height": {
      "$description": "Step names are the unitless value x 100.",
      "112": { "$value": "1.125" },
      "125": { "$value": "1.25" },
      "130": { "$value": "1.3" },
      "140": { "$value": "1.4" },
      "150": { "$value": "1.5" },
      "170": { "$value": "1.7" }
    },
    "letter-spacing": {
      "$description": "Not emitted to CSS; set directly in component styles.",
      "0": { "$value": "0" }
    },
    "text-transform": {
      "$description": "Not emitted to CSS; set directly in component styles.",
      "none": { "$value": "none" }
    }
  }
}
