{
  "color": {
    "text": {
      "default": { "$value": "{color.neutral.900}", "$description": "Text on white, gray, and gold surfaces." },
      "inverse": { "$value": "{color.neutral.0}", "$description": "Text on black surfaces." }
    },
    "background": { "$value": "{color.neutral.0}", "$description": "Default page background." },
    "link": {
      "default": { "$value": "{color.blue}", "$description": "Link on white and gray surfaces." },
