    "warning-surface": { "$value": "{color.warning-wash}", "$description": "Fill behind a warning message. Pair with warning as the border." },
    "danger-surface": { "$value": "{color.danger-wash}", "$description": "Fill behind an error message. Pair with danger as the border." }
  }
