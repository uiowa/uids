{
  "color": {
    "text": { "$value": "{color.black}", "$description": "Default text color." },
    "background": { "$value": "{color.white}", "$description": "Default page background." },
    "link": { "$value": "{color.blue}", "$description": "Text link color." },
    "brand": { "$value": "{color.gold}", "$description": "Primary brand color." },
    "bg": {
      "black": { "$value": "{color.black}", "brandChannel": "secondary", "$description": "Black section background." },
      "gold": { "$value": "{color.gold}", "brandChannel": "primary", "$description": "Gold section background." },
      "gray": { "$value": "{color.gray.100}", "$description": "Gray section background." },
      "white": { "$value": "{color.white}", "$description": "White section background." }
    },
    "border": {
      "default": { "$value": "{color.alpha.black-125}", "$description": "Default border on light and ambient backgrounds." },
      "on-dark": { "$value": "{color.alpha.white-325}", "$description": "Default border inside dark sections." }
    },
    "on-light": {
      "text": { "$value": "{color.black}", "brandChannel": "secondary", "$description": "Text on a light or gold section background." },
      "link": { "$value": "{color.black}", "brandChannel": "secondary", "$description": "Link on a light or gold section background." }
    },
    "on-dark": {
      "text": { "$value": "{color.white}", "$description": "Text on a dark section background." },
      "link": { "$value": "{color.gold}", "brandChannel": "primary", "$description": "Link on a dark section background." }
    }
  }
}
