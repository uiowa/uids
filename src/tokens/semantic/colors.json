{
  "color": {
    "$type": "color",
    "text": {
      "default": { "$value": "{color.neutral.900}", "$description": "Text on white, gray, and gold surfaces." },
      "inverse": { "$value": "{color.neutral.0}", "$description": "Text on black surfaces." }
    },
    "background": {
      "$description": "Fills behind page and section content.",
      "default": { "$value": "{color.neutral.0}" },
      "black": { "$value": "{color.brand.black}" },
      "gold": { "$value": "{color.brand.gold}" },
      "gray": { "$value": "{color.neutral.100}" },
      "white": { "$value": "{color.neutral.0}" }
    },
    "link": {
      "default": { "$value": "{color.blue-dark}", "$description": "Link on white and gray surfaces." },
      "inverse": { "$value": "{color.brand.gold}", "$description": "Link on black surfaces." },
      "gold": { "$value": "{color.neutral.900}", "$description": "Link on gold surfaces." }
    },
    "brand": {
      "$description": "University of Iowa brand colors.",
      "gold": { "$value": "{color.gold}" },
      "black": { "$value": "{color.neutral.900}" }
    },
    "accent": {
      "$description": "Decorative emphasis. Draw one item out of a set; never signal status.",
      "teal": { "$value": "{color.teal}" },
      "orange": { "$value": "{color.orange}" },
      "magenta": { "$value": "{color.magenta}" },
      "ochre": { "$value": "{color.ochre}" }
    },
    "border": {
      "default": { "$value": "{color.alpha.black-125}", "$description": "Border on white, gray, and gold surfaces." },
      "inverse": { "$value": "{color.alpha.white-325}", "$description": "Border on black surfaces." }
    },
    "info": { "$value": "{color.blue}", "$description": "Informational status. Never decoration." },
    "success": { "$value": "{color.green}", "$description": "Success status. Never decoration." },
    "warning": { "$value": "{color.ochre-dark}", "$description": "Warning status. Never decoration." },
    "danger": { "$value": "{color.red}", "$description": "Error status. Never decoration." },
    "info-surface": { "$value": "{color.blue-wash}", "$description": "Fill behind an info message. Pair with info as the border." },
    "success-surface": { "$value": "{color.green-wash}", "$description": "Fill behind a success message. Pair with success as the border." },
    "warning-surface": { "$value": "{color.ochre-wash}", "$description": "Fill behind a warning message. Pair with warning as the border." },
    "danger-surface": { "$value": "{color.red-wash}", "$description": "Fill behind an error message. Pair with danger as the border." }
  }
}
