      "gold": { "$value": "{color.neutral.900}", "$description": "Link on gold surfaces." }
    },
    "brand": { "$value": "{color.gold}", "$description": "Primary brand color." },
    "bg": {
      "black": { "$value": "{color.black}", "$description": "Black section background." },
      "gold": { "$value": "{color.gold}", "$description": "Gold section background." },
      "gray": { "$value": "{color.neutral.100}", "$description": "Gray section background." },
      "white": { "$value": "{color.neutral.0}", "$description": "White section background." }
    },
    "border": {
      "default": { "$value": "{color.alpha.black-125}", "$description": "Border on white, gray, and gold surfaces." },
      "inverse": { "$value": "{color.alpha.white-325}", "$description": "Border on black surfaces." }
    },
    "info-surface": { "$value": "{color.info-wash}", "$description": "Fill behind an info message. Pair with info as the border." },
