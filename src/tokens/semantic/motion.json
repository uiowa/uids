{
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Durations by purpose.",
      "fast": { "$value": "{duration.150}", "$description": "Hover and focus feedback." },
      "medium": { "$value": "{duration.250}", "$description": "State changes and small movement." },
      "slow": { "$value": "{duration.400}", "$description": "Larger movement and slower changes." }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Easing curves, named by purpose.",
    "standard": { "$value": [0.4, 0, 0.2, 1], "$description": "The default, for movement and change on screen." },
    "overshoot": { "$value": [0.3, 1.5, 0.7, 1], "$description": "A small overshoot for playful emphasis." }
  }
}
