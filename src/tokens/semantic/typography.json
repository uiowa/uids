        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.sans}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.base.fontSize}",
