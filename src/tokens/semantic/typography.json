          "fontFamily": "{typography.font-family.zilla-slab}",
          "fontWeight": "{typography.font-weight.medium-bold}",
          "fontSize": "{typography.font-size.230}",
          "letterSpacing": "{typography.letter-spacing.normal}",
          "lineHeight": "{typography.line-height.115}"
        },
        "$extensions": {
          "edu.uiowa.fluid": {
            "strategy": "exponential",
            "exponent": 1.34,
            "minViewport": { "value": 600, "unit": "px" },
            "maxViewport": { "value": 1310, "unit": "px" }
