      "small": { "$value": "{typography.font-size.80}" },
      "large": { "$value": "{typography.font-size.160}" }
    },
    "typeface": {
      "$type": "fontFamily",
      "$description": "Typeface roles, named after Foundations' font families.",
      "display": { "$value": "{typography.font-family.special-gothic-condensed}", "$description": "Foundations' display face: the headline and eyebrow styles." },
      "slab": { "$value": "{typography.font-family.zilla-slab}", "$description": "The lead-in and section heads: the subhead styles." },
      "sans": { "$value": "{typography.font-family.roboto}", "$description": "Details, reading text and component text: the subhead 2, body and label styles." }
    },
    "base": {
      "$description": "The reading size: Body Medium, and the one number every role and every space is measured against. 1.2rem, the UIDS body size.",
      "fontSize": { "$type": "dimension", "$value": "{typography.font-size.120}" }
    },
    "scale": {
      "$type": "number",
      "$description": "Multipliers of the reading size for the space between text.",
      "related": { "$value": 1.5 },
      "break": { "$value": 2 }
    },
    "space": {
      "$type": "dimension",
      "$description": "Space between text elements: the reading size times a multiplier.",
      "related": {
        "$description": "Between closely related elements, such as a heading and its text.",
        "$value": "{typography.base.fontSize}",
        "$extensions": { "edu.uiowa.multiply": { "by": "{typography.scale.related}" } }
      },
      "break": {
        "$description": "Below display type, and between distinct sections or content groups.",
        "$value": "{typography.base.fontSize}",
        "$extensions": { "edu.uiowa.multiply": { "by": "{typography.scale.break}" } }
      }
    },
