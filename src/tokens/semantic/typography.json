{
  "typography": {
    "heading-h1": {
      "$type": "typography",
      "$description": "h1.",
      "$value": {
        "fontFamily": "{typography.font-family.zilla-slab}",
        "fontWeight": "{typography.font-weight.medium-bold}",
        "fontSize": "{typography.font-size.230}",
        "lineHeight": "{typography.line-height.115}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "heading-h2": {
      "$type": "typography",
      "$description": "h2.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": "{typography.font-size.195}",
        "lineHeight": "{typography.line-height.125}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "heading-h3": {
      "$type": "typography",
      "$description": "h3.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": "{typography.font-size.165}",
        "lineHeight": "{typography.line-height.125}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "heading-h4": {
      "$type": "typography",
      "$description": "h4.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": "{typography.font-size.145}",
        "lineHeight": "{typography.line-height.125}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "heading-h5": {
      "$type": "typography",
      "$description": "h5.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": "{typography.font-size.130}",
        "lineHeight": "{typography.line-height.125}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "heading-h6": {
      "$type": "typography",
      "$description": "h6. The only heading with a single size.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": "{typography.font-size.120}",
        "lineHeight": "{typography.line-height.125}"
      },
      "$extensions": { "edu.uiowa.fluid": true }
    },
    "intro-bold": {
      "$type": "typography",
      "$description": "Bold intro paragraph.",
      "$value": {
        "fontFamily": "{typography.font-family.zilla-slab}",
        "fontWeight": "{typography.font-weight.medium-bold}",
        "fontSize": "{typography.font-size.160}",
        "lineHeight": "{typography.line-height.130}"
      },
      "$extensions": { "edu.uiowa.fluid": "{typography.font-size.220}" }
    },
    "intro-light": {
      "$type": "typography",
      "$description": "Light intro paragraph.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.light}",
        "fontSize": "{typography.font-size.160}",
        "lineHeight": "{typography.line-height.140}"
      },
      "$extensions": { "edu.uiowa.fluid": "{typography.font-size.210}" }
    },
    "body": {
      "$type": "typography",
      "$description": "Default body copy.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.normal}",
        "fontSize": "{typography.font-size.120}",
        "lineHeight": "{typography.line-height.170}"
      }
    },
    "size": {
      "$description": "Size modifiers on body text. Everything else about the style holds.",
      "small": { "$value": "{typography.font-size.80}" },
      "large": { "$value": "{typography.font-size.160}" }
    }
  }
}
