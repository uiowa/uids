{
  "typography": {
    "heading-h1": {
      "$type": "typography",
      "$description": "h1.",
      "$value": {
        "fontFamily": "{typography.font-family.zilla-slab}",
        "fontWeight": "{typography.font-weight.medium-bold}",
        "fontSize": { "min": "{typography.font-size.230}", "max": "{typography.font-size.335}" },
        "lineHeight": "{typography.line-height.115}"
      }
    },
    "heading-h2": {
      "$type": "typography",
      "$description": "h2.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": { "min": "{typography.font-size.195}", "max": "{typography.font-size.230}" },
        "lineHeight": "{typography.line-height.125}"
      }
    },
    "heading-h3": {
      "$type": "typography",
      "$description": "h3.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.medium}",
        "fontSize": { "min": "{typography.font-size.165}", "max": "{typography.font-size.191}" },
        "lineHeight": "{typography.line-height.125}"
      }
    },
    "heading-h4": {
      "$type": "typography",
      "$description": "h4.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
