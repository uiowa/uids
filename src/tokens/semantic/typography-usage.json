    "caption": {
      "$type": "typography",
      "$description": "Figure captions.",
      "$value": {
        "fontFamily": "{typography.font-family.roboto}",
        "fontWeight": "{typography.font-weight.normal}",
        "fontSize": "{typography.font-size.90}",
