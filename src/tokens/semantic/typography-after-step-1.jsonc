{
  "typography": {
    "typeface": {
      "$type": "fontFamily",
      "$description": "Typeface roles. Every style points at one of these rather than at a font, so changing a face is one edit.",
      "brand": { "$value": "{typography.font-family.zilla-slab}", "$description": "Expressive text: headline.large and intro.bold." },
      "plain": { "$value": "{typography.font-family.roboto}", "$description": "Everything else." }
    },
    "headline": {
      "$description": "High-emphasis short text, such as page and section headings. Was heading.h1 to h3.",
      "large": {
        "$description": "Was heading.h1.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.brand}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium-bold}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.230}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.115}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "medium": {
        "$description": "Was heading.h2.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.195}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.125}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "small": {
        "$description": "Was heading.h3.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.165}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.125}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      }
    },
    "title": {
      "$description": "Medium-emphasis short text. Was heading.h4 to h6.",
      "large": {
        "$description": "Was heading.h4.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.145}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.125}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "medium": {
        "$description": "Was heading.h5.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.130}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.125}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "small": {
        "$description": "Was heading.h6.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.120}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "strategy": "exponential",
              "exponent": 1.34,
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" }
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.125}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      }
    },
    "body": {
      "$description": "Reading text. Was body, size.large and size.small.",
      "large": {
        "$description": "Was size.large.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" },
        "fontSize": { "$type": "dimension", "$value": "{typography.font-size.160}" },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.170}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "medium": {
        "$description": "Was body.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" },
        "fontSize": { "$type": "dimension", "$value": "{typography.font-size.120}" },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.170}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "small": {
        "$description": "Was size.small.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" },
        "fontSize": { "$type": "dimension", "$value": "{typography.font-size.80}" },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.170}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      }
    },
    "intro": {
      "$description": "Outside the Material 3 scale: its 15 slots have no lead paragraph in two faces. Was intro-bold and intro-light.",
      "bold": {
        "$description": "Was intro-bold.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.brand}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.medium-bold}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.160}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" },
              "max": "{typography.font-size.220}"
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.130}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      },
      "light": {
        "$description": "Was intro-light.",
        "fontFamily": { "$type": "fontFamily", "$value": "{typography.typeface.plain}" },
        "fontWeight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" },
        "fontSize": {
          "$type": "dimension",
          "$value": "{typography.font-size.160}",
          "$extensions": {
            "edu.uiowa.fluid": {
              "minViewport": { "value": 600, "unit": "px" },
              "maxViewport": { "value": 1310, "unit": "px" },
              "max": "{typography.font-size.210}"
            }
          }
        },
        "lineHeight": { "$type": "number", "$value": "{typography.line-height.140}" },
        "letterSpacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" }
      }
    }
  }
}
