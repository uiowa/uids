{
  "layout": {
    "$type": "dimension",
    "container": {
      "max": {
        "$description": "Maximum width of the content column.",
        "standard": { "$value": { "value": 81.875, "unit": "rem" } },
        "narrow": { "$value": { "value": 63.75, "unit": "rem" } },
        "wide": { "$value": { "value": 100, "unit": "rem" } }
      }
    },
    "breakpoint": {
      "$description": "Width at which the content column reaches its maximum.",
      "standard": { "$value": "{breakpoint.1350}" }
    }
  }
}
