{
  "layout": {
    "$type": "dimension",
    "container": {
      "max": {
        "$description": "Maximum width of the content column.",
        "standard": { "$value": { "value": 81.875, "unit": "rem" } },
        "narrow": { "$value": { "value": 63.75, "unit": "rem" } },
        "wide": { "$value": { "value": 100, "unit": "rem" } }
      }
    },
    "breakpoint": {
      "$description": "Width at which the content column reaches its maximum.",
      "standard": { "$value": "{breakpoint.1350}" }
    },
    "space": {
      "$description": "Space between elements, stacked or side by side. The same at every tier.",
      "tight": { "$value": "{space.50}" },
      "related": { "$value": "{space.150}" },
      "separated": { "$value": "{space.200}" },
      "section": { "$value": "{space.300}" }
    },
    "digital": {
      "$description": "Grid values for each digital size tier, measured by window width.",
      "small": {
        "columns": { "$type": "number", "$value": 4 },
        "margin": { "$value": "{space.100}" },
        "gutter": { "$value": "{space.100}" },
        "padding": { "$value": "{layout.digital.small.gutter}" },
        "reading": { "$type": "number", "$value": 4 }
      },
      "medium": {
        "columns": { "$type": "number", "$value": 12 },
        "margin": { "$value": "{space.200}" },
        "gutter": { "$value": "{space.100}" },
        "padding": { "$value": "{layout.digital.medium.gutter}" },
        "reading": { "$type": "number", "$value": 10 }
      },
      "large": {
        "columns": { "$type": "number", "$value": 12 },
        "margin": { "$value": "{space.200}" },
        "gutter": { "$value": "{space.150}" },
        "padding": { "$value": "{layout.digital.large.gutter}" },
        "reading": { "$type": "number", "$value": 8 }
      }
    }
  }
}
