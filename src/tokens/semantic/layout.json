{
  "layout": {
    "gutter": {
      "width": {
        "mobile": { "$value": "{space.125}", "$description": "Side margins and section side spacing below md." },
        "desktop": { "$value": "{space.300}", "$description": "Grid gaps and full-width side margins from md." }
      },
      "height": {
        "mobile": { "$value": "{space.200}", "$description": "Stacked-region and content-grid vertical gap." },
        "desktop": { "$value": "{space.800}", "$description": "Large vertical spacing in selected components." }
      }
    },
    "section": {
      "padding": {
        "mobile": { "$value": "{space.125}", "$description": "Section top and bottom padding below sm. Note this switches at sm, not md." },
        "default": { "$value": "{space.300}", "$description": "Section top and bottom padding from sm." },
        "extra": { "$value": "{space.600}", "$description": "Extra section top and bottom padding." }
      }
    },
    "block": {
      "stack": {
        "default": { "$value": "{space.150}", "$description": "Default spacing between sibling blocks." },
        "compact": { "$value": "{space.100}", "$description": "Compact spacing between sibling blocks." },
        "extra": { "$value": "{space.200}", "$description": "Extra spacing between sibling blocks." }
      }
    },
    "container": {
      "max": {
        "standard": { "$value": "81.875em", "$description": "Standard container cap." },
        "narrow": { "$value": "63.75em", "$description": "Narrow container cap." },
        "wide": { "$value": "100em", "$description": "Extended container cap." }
      },
      "padding": {
        "wide": { "$value": "{space.200}", "$description": "Extended container side padding." }
      }
    }
  }
}
