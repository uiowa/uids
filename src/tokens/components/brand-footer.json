{
  "brand-footer": {
    "$description": "IOWA brand footer.",
    "background": { "$type": "color", "$value": "{color.background.black}" },
    "text": {
      "color": { "$type": "color", "$value": "{color.neutral.175}", "$description": "Default footer body text." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}", "$description": "Light weight for footer body text." },
      "line-height": { "$type": "number", "$value": "{typography.line-height.140}", "$description": "Body text line height." }
    },
    "link": {
      "color": { "$type": "color", "$value": "{color.brand.gold}", "$description": "Footer links stay gold rather than using color.link.inverse." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" }
    },
    "site-name": {
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.font-size.165}", "$description": "Site name size in the footer." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.heavy}" }
    },
    "parent-site-name": {
      "color": { "$type": "color", "$value": "{brand-footer.text.color}" },
      "font-size": { "$type": "dimension", "$value": "{typography.font-size.140}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" }
    },
    "menu": {
      "link": {
        "color": { "$type": "color", "$value": "{color.text.inverse}" },
        "font-size": { "$type": "dimension", "$value": "{typography.font-size.120}", "$description": "Footer menu link size." },
        "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" }
      }
    },
    "social-icon": {
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.size.large}" }
    },
    "contact-icon": {
      "color": { "$type": "color", "$value": "{color.neutral.300}", "$description": "Contact icon color, dimmer than the text beside it." },
      "font-size": { "$type": "dimension", "$value": "{typography.size.small}" }
    },
    "legal-bar": {
      "$description": "Items in the legal-bar menu.",
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.size.small}" },
      "border-color": { "$type": "color", "$value": "{color.border.inverse}", "$description": "Divider between legal-bar items." },
      "link": {
        "color": { "$type": "color", "$value": "{color.brand.gold}", "$description": "Footer links stay gold rather than using color.link.inverse." }
      }
    }
  }
}
