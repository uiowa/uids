{
  "brand-footer": {
    "$description": "IOWA brand footer.",
    "background": { "$type": "color", "$value": "{color.background.black}" },
    "text": {
      "color": { "$type": "color", "$value": "{color.neutral.175}", "$description": "Replaces #CCC." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}", "$description": "Replaces 100, which Roboto does not load." },
      "line-height": { "$type": "number", "$value": "{typography.line-height.140}", "$description": "Replaces 1.5." }
    },
    "link": {
      "color": { "$type": "color", "$value": "{color.brand.gold}", "$description": "Footer links stay gold rather than using color.link.inverse." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.normal}" }
    },
    "site-name": {
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.font-size.165}", "$description": "Replaces 1.7rem." },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.heavy}" }
    },
    "parent-site-name": {
      "color": { "$type": "color", "$value": "{brand-footer.text.color}" },
      "font-size": { "$type": "dimension", "$value": "{typography.font-size.140}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" }
    },
    "menu": {
      "link": {
        "color": { "$type": "color", "$value": "{color.text.inverse}" },
        "font-size": { "$type": "dimension", "$value": "{typography.font-size.120}", "$description": "Replaces 1.1rem." },
        "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" }
      }
    },
    "social-icon": {
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.size.large}" }
    },
    "contact-icon": {
      "color": { "$type": "color", "$value": "{color.neutral.300}", "$description": "Replaces #999. Dimmer than the text beside it." },
      "font-size": { "$type": "dimension", "$value": "{typography.size.small}" }
    },
    "socket": {
      "$description": "Items in the socket menu.",
      "color": { "$type": "color", "$value": "{color.text.inverse}" },
      "font-size": { "$type": "dimension", "$value": "{typography.size.small}" },
      "border-color": { "$type": "color", "$value": "{color.border.inverse}", "$description": "Divider between items. Replaces #5D5656. Width uses stroke.width.default." },
      "link": {
        "color": { "$type": "color", "$value": "{color.brand.gold}", "$description": "Footer links stay gold rather than using color.link.inverse." }
      }
    }
  }
}
