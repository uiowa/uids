{
  "brand-bar": {
    "$extensions": { "edu.uiowa.variants": { "narrow": ".iowa-bar--narrow" } },
    "$description": "IOWA brand bar.",
    "background": {
      "$type": "color",
      "$value": "{color.background.black}",
      "$description": "Bar fill; black by default, gold at md and up.",
      "$extensions": { 
        "edu.uiowa.responsive": {
          "md": "{color.background.gold}" 
        }
      }
    },
    "site-name": {
      "color": { "$type": "color", "$value": "{color.link.gold}" },
      "background": {
        "$type": "color",
        "$value": "{color.background.gold}",
        "$description": "Gold strip under the logo row; transparent at md and up, where the site name sits in the bar.",
        "$extensions": {
          "edu.uiowa.responsive": {
            "md": "{color.background.transparent}"
          }
        }
      },
      "font-family": { "$type": "fontFamily", "$value": "{typography.font-family.roboto}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" },
      "font-size": {
        "$type": "dimension",
        "$value": "{typography.font-size.165}",
        "$extensions": {
          "edu.uiowa.fluid": {
            "minViewport": "{breakpoint.md}",
            "maxViewport": "{breakpoint.standard}",
            "max": "{typography.font-size.220}"
          },
          "edu.uiowa.variant": { "narrow": "{typography.font-size.100}" }
        }
      },
      "letter-spacing": { "$type": "dimension", "$value": "{typography.letter-spacing.normal}" },
      "line-height": { "$type": "number", "$value": "{typography.line-height.115}" }
    },
    "content": {
      "background": {
        "$type": "color",
        "$value": "{color.background.gold}",
        "$description": "Continues the gold strip under the site name; transparent at md and up, where the content sits in the bar.",
        "$extensions": {
          "edu.uiowa.responsive": {
            "md": "{color.background.transparent}"
          }
        }
      }
    }
  }
}
