{
  "brand-bar": {
    "$extensions": { "edu.uiowa.variants": { "narrow": ".iowa-bar--narrow" } },
    "$description": "IOWA brand bar.",
    "background": {
      "$type": "color",
      "$value": "{color.background.gold}",
      "$description": "Bar fill."
    },
    "site-name": {
      "color": { "$type": "color", "$value": "{color.link.gold}" },
      "font-family": { "$type": "fontFamily", "$value": "{typography.font-family.roboto}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" },
      "line-height": { "$type": "number", "$value": "{typography.line-height.115}" },
      "font-size": {
        "$type": "dimension",
        "$value": "{typography.font-size.165}",
        "$extensions": {
          "edu.uiowa.fluid": {
            "minViewport": "{breakpoint.md}",
            "maxViewport": "{breakpoint.standard}",
            "max": "{typography.font-size.220}"
          },
          "edu.uiowa.variant": { "narrow": "{typography.font-size.120}" }
        }
      }
    }
  }
}
