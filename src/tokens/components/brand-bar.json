{
  "brand-bar": {
    "$description": "IOWA brand bar.",
    "background": { "$type": "color", "$value": "{color.background.gold}", "$description": "Bar fill at md and up." },
    "site-name": {
      "color": { "$type": "color", "$value": "{color.link.gold}" },
      "typography": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.font-family.roboto}",
          "fontWeight": "{typography.font-weight.light}",
          "fontSize": "{typography.font-size.165}",
          "letterSpacing": "{typography.letter-spacing.normal}",
          "lineHeight": "{typography.line-height.115}"
        },
        "$extensions": {
          "edu.uiowa.fluid": {
            "minViewport": { "value": 980, "unit": "px" },
            "maxViewport": { "value": 1350, "unit": "px" },
            "max": "{typography.font-size.220}"
          }
        }
      }
    },
    "parent-site-name": {
      "color": { "$type": "color", "$value": "{color.link.gold}" },
      "font-weight": { "$type": "fontWeight", "$value": "{typography.font-weight.light}" }
    },
    "below-md": {
      "$description": "Below md (980px), where the logo row sits above the site name.",
      "background": { "$type": "color", "$value": "{color.background.black}" },
      "site-name": {
        "background": { "$type": "color", "$value": "{color.background.gold}" }
      },
      "parent-site-name": {
        "background": { "$type": "color", "$value": "{color.background.gold}" }
      }
    },
    "narrow": {
      "site-name": {
        "font-size": { "$type": "dimension", "$value": "{typography.font-size.100}" }
      }
    },
    "below": {
      "$description": "Container under the bar that holds the site name.",
      "background": { "$type": "color", "$value": "{color.background.white}" },
      "border-color": { "$type": "color", "$value": "{color.border.default}", "$description": "Replaces #E6E5E5. Width uses stroke.width.default." }
    }
  }
}
