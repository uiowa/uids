{
  "name": "uids",
  "type": "module",
  "version": "5.0.0-alpha.1",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "description": "The UIowa Design System is specific to the University of Iowa.",
  "keywords": [
    "uiowa",
    "design"
  ],
  "homepage": "https://uids.brand.uiowa.edu",
  "style": "./dist/uids.css",
  "sass": "./src/scss/uids.scss",
  "files": [
    "dist",
    "src/assets",
    "src/scss",
    "src/tokens"
  ],
  "exports": {
    "./uids.css": "./dist/uids.css",
    "./uids-core.css": "./dist/uids-core.css",
    "./tokens.css": "./dist/tokens.css",
    "./components/*.css": "./dist/components/*.css",
    "./scss/*": "./src/scss/*",
    "./tokens/*.json": "./src/tokens/*.json"
  },
  "scripts": {
    "build:tokens": "style-dictionary build --config style-dictionary.config.js",
    "prepare": "yarn build:tokens",
    "prepack": "yarn build",
    "dev": "yarn build:tokens && sass --watch src/scss:dist",
    "build": "yarn build:tokens && sass src/scss:dist",
    "production": "yarn build:tokens && storybook build -o www && sass src/scss:www/dist/css",
    "preview": "vite preview --port 5050",
    "test:unit": "yarn build:tokens && vitest --environment jsdom",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:5050/ 'cypress open'",
    "test:e2e:ci": "start-server-and-test preview http://127.0.0.1:5050/ 'cypress run'",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "storybook": "yarn build:tokens && storybook dev -p 6006",
    "build-storybook": "yarn build:tokens && storybook build"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@whitespace/storybook-addon-html": "9.0.0",
    "jsdom": "^31.0.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "sass": "^1.108.1",
    "storybook": "^10.6.7",
    "style-dictionary": "5.8.0",
    "vite": "^8.3.7",
    "vitest": "5.1.0",
    "webpack": "^5.112.2"
  },
  "packageManager": "yarn@3.7.0"
}
