{
  "name": "uids",
  "type": "module",
  "version": "4.0.1",
  "license": "MIT",
  "description": "The UIowa Design System is specific to the University of Iowa.",
  "keywords": [
    "uiowa",
    "design"
  ],
  "homepage": "https://uids.brand.uiowa.edu",
  "main": "./dist/uids.umd.js",
  "module": "./dist/uids.es.js",
  "style": "",
  "exports": {
    "import": "./dist/uids.es.js",
    "require": "./dist/uids.umd.js"
  },
  "scripts": {
    "dev": "yarn build:tokens && sass --watch src/scss:dist",
    "build": "yarn build:tokens && sass src/scss:dist",
    "production": "yarn build:tokens && storybook build -o www && sass src/scss:www/dist/css",
    "test:unit": "vitest --environment jsdom",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:ci": "eslint src scripts .storybook --ext .vue,.js,.mjs,.ts --quiet",
    "test:unit:ci": "vitest run --environment jsdom",
    "check:drift": "node scripts/build-tokens.mjs --check && node scripts/build-catalog.mjs --check && node scripts/check-contracts.mjs && node scripts/check-claude-design.mjs && node scripts/build-dc-rules.mjs --check && node scripts/check-figma.mjs && node scripts/check-citations.mjs && node scripts/check-token-consumers.mjs",
    "test:styles": "node scripts/check-styles.mjs",
    "test:styles:update": "node scripts/check-styles.mjs --update",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^9",
    "@vue/eslint-config-typescript": "^13",
    "@vue/test-utils": "^2",
    "@whitespace/storybook-addon-html": "9.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-storybook": "^0.8",
    "eslint-plugin-vue": "^9",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "puppeteer": "^24",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-syntax-highlighter": "^16.1.1",
    "sass": "^1.100.0",
    "storybook": "^10.4.1",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^3",
    "webpack": "^5.107.2"
  },
  "packageManager": "yarn@3.7.0"
}
