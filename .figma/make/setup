#!/usr/bin/env bash
# One-time machine setup for Figma Make: make sure Node 22 and Yarn (via corepack) are available.
set -eo pipefail
# Put Node 22 on PATH: nvm first, then Homebrew's node@22. Each Make script runs in a fresh
# shell, so this block is repeated in setup, install and dev rather than shared (Make documents
# exactly five files in this folder). nvm.sh is not safe under set -u, so -u is not used here.
use_node_22() {
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh" && nvm use 22 >/dev/null 2>&1 || true
  fi
  if command -v brew >/dev/null 2>&1 && [ -d "$(brew --prefix node@22 2>/dev/null)/bin" ]; then
    export PATH="$(brew --prefix node@22)/bin:$PATH"
  fi
}
node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }

use_node_22
if [ "$(node_major)" -lt 22 ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh" && nvm install 22 >/dev/null && nvm use 22 >/dev/null
fi
if [ "$(node_major)" -lt 22 ] && command -v brew >/dev/null 2>&1; then
  brew install node@22 >/dev/null && use_node_22
fi
if [ "$(node_major)" -lt 22 ]; then
  echo "Node 22 or newer is required; found $(node -v 2>/dev/null || echo none)" >&2
  exit 1
fi
corepack enable >/dev/null 2>&1 || true
echo "setup ok: node $(node -v)"
